# Keep repository clean: scripts only, no scraped/exported data.

# Python
__pycache__/
*.py[cod]
*$py.class
.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
scrapy_env/

# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key
*.crt
# The restored .claude handover archive: an auth token copy
# (.credentials.json.tmp.*), .claude.json backups and file-history snapshots of
# scripts from before the pg password moved to .env - none matched by *.json.
claude_proj_session/
# Holds the local pg password in its connection string; *.json covers it today,
# this keeps it out if that data rule is ever loosened.
.mcp.json

# Scraped/exported data
*.csv
*.tsv
*.json
*.jsonl
*.xlsx
*.xls
*.parquet
*.db
*.sqlite
*.sqlite3

# Generated reports and media
Europe/**/output/
Europe/**/*.txt
!Europe/requirements.txt
Europe/**/*.html
Europe/**/*.log
deliveroo/**/*.json
agoda-hotels/**/*.xlsx
noon-platform/**/*.json
noon-platform/**/*.txt
healthcare/**/*.html
google-place/output/
google-place/logs/
google-place/*.csv
apify/output/
apify/*.json
foodpanda-bangladesh/data/
foodpanda-bangladesh/logs/
foodpanda-bangladesh/**/*.csv
foodpanda-bangladesh/**/*.json
!foodpanda-bangladesh/config/cities.json
foodpanda-bangladesh/**/*.xlsx
expert-of-deals/output/
expert-of-deals/**/*.csv
expert-of-deals/**/*.json
!expert-of-deals/sample_output_preview.json
**/PLAN.md
**/SCRAPE_PLAN.md
Gofood-Indonesia/**/*.txt
elmenus-cairo/**/*.txt
foodi-Bangladesh/**/*.txt
Hungerstation/**/*.txt
talabat/**/*.txt
!talabat/**/requirements.txt
*.avif
*.png
*.jpg
*.jpeg
*.webp
!assets/
!assets/logos/
!assets/logos/*.png

# Browser / Playwright artifacts
playwright-report/
test-results/
downloads/
screenshots/
videos/
storage_state*.json

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
# `*.bak` does NOT match `.bak9` / `.bak21` - numbered rollback copies of the
# export JSON, 6.3 MB each. Thirteen of them reached the index before this rule.
*.bak[0-9]
*.bak[0-9][0-9]
# stdout captures from long runs: logs by another name
*.out

# Documentation files should stay local unless intentionally force-added.
*.md
!README.md
!Readme.md
!README.template.md

# talabat is the live deliverable pipeline: its written context (why a stage
# exists, which rules were measured, what the traps are) is as load-bearing as
# the code and must survive a machine handover. Cache dirs are excluded above,
# and a file under an ignored directory cannot be re-included, so the
# .pytest_cache/.mypy_cache READMEs stay out on their own.
!talabat/**/*.md

# --- Exceptions to the "no data in git" rule -------------------------------
# These are metadata and controlled vocabularies, not bulk data. Named one by
# one rather than by wildcard so nothing else in these folders can drift in.

# The S3 archive's own records. 15 GB of Talabat data lives in
# s3://rii-data-dump and the local copies are deleted; these files are the only
# description of what is up there. Without them s3_archive/*.py still runs but
# has nothing to reconcile against: verify_s3.py cannot prove a byte,
# restore_from_s3.py cannot find a key, and there is no map from a deleted local
# path to its s3:// URI. 1.6 MB to keep the archive legible from any machine.
!talabat/s3_archive/data/staged_manifest.jsonl
!talabat/s3_archive/data/upload_manifest.jsonl
!talabat/s3_archive/data/deleted_index.csv
!talabat/s3_archive/data/inventory.csv
!talabat/s3_archive/data/inventory_summary.json
!talabat/s3_archive/data/verify_report.json
!talabat/s3_archive/data/console_check.csv
!talabat/s3_archive/bucket_lifecycle.json

# Controlled vocabularies. The taxonomy is deliberately closed - a stage may map
# onto an existing std_term but never invent one - so the vocabulary IS the
# contract, and it belongs under version control where a change shows up as a
# diff rather than as a silently wider taxonomy next month.
!talabat/menu/final_std_terms_taxonomy.csv
!talabat/area_classification/area_list.csv
!talabat/menu_refresh/data/std_term_canonical_ingredients.json
!talabat/unified/data/arabic_fixes.json

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

