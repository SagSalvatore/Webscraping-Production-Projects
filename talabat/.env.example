# Oxylabs Residential Proxy — UAE geo-targeted exit nodes
# Sign up at: https://oxylabs.io/
OXYLABS_USERNAME=your_oxylabs_username
OXYLABS_PASSWORD=your_oxylabs_password
OXYLABS_COUNTRY=""

# Local PostgreSQL — read by talabat/db_config.py, which loads this file itself.
# Required: every script that touches RestaurantIntelligence imports it, and a
# missing PG_PASSWORD fails loudly at import rather than at connect time.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=RestaurantIntelligence
PG_USER=postgres
PG_PASSWORD=your_postgres_password

# Supabase — Project-2 (UAE Food Aggregator Intelligence)
# Get from: Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_jwt_key_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Direct PostgreSQL (asyncpg) — for fast bulk operations like async_sanitize.py
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI mode)
SUPABASE_DB_URL=postgresql://postgres:[DB_PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# OpenAI — gpt-4o-mini classification pipeline
# Get from: platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here

# LangSmith — observability for classification runs (optional, pass --langsmith flag)
# Get from: smith.langchain.com/settings
LANGSMITH_API_KEY=lsv2_pt_...your-key-here
LANGSMITH_PROJECT=RAG_LEARNING
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- AWS S3 archive (s3://rii-data-dump, us-west-2) -------------------------
# IAM console -> Users -> your user -> Security credentials -> Create access key
# ("Application running outside AWS"). The secret is shown ONCE.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for TEMPORARY credentials (aws sts get-session-token / assume-role).
# Leave empty for a normal long-lived access key.
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-west-2
